---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const books = await getCollection('books')

export const prerender = true
---

<Layout>
	<main title="About" >
        <h1 class="text-center bg-[#3E2F31] w-full py-20 text-7xl font-extrabold mb-24 text-white">
            Grandes novelas
        </h1>

		<section aria-label="Obras maestras" class="pb-20">
			<div class="mx-auto max-w-7xl">
				<div class="grid gap-6 md:grid-cols-2">
					{
						books.map(book => {
							const {slug, data} = book
							const { title, author, img, description, pages, buy } = data

							return (
								<article class="flex">
									<a href={`/libro/${slug}`} class="mb-2 xl:mb-0 transition hover:scale-110">
										<img 
											transition:name={`img-${slug}`}
											class="mr-5 w-60 rounded"
											src={`../src/assets/${img}`} 
											alt="title" 
										/>
									</a>	

									<div class="flex flex-col justify-center px-4">
										<h2 transition:name={`title-${slug}`} class="mb-2 text-2xl font-bold leading-tight text-black">
											{title}
										</h2>

										<p class="mb-4 text-gray-600 max-w-sm">{description}</p>
										<span class="text-xs">Paginas: {pages}</span>
									</div>
								</article>
							)
						})
					}
				</div>
			</div>
		</section>
    </main>
</Layout>
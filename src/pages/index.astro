---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const books = await getCollection('books')

export const prerender = true
---

<Layout>
	<main title="About" >
        <h1 class="text-center bg-[#3E2F31] w-full py-10 text-7xl font-extrabold mb-24 text-white">
            Grandes novelas
        </h1>

		<section aria-label="Obras maestras" class="pb-20">
			<div class="mx-auto max-w-7xl">
				<div class="flex items-center mb-4">
					<h2 class="text-2xl font-bold mr-2">Libros</h2>
					<div class="flex-1 border-b border-gray-500"></div>
				</div>
				<div class="flex overflow-x-auto snap-x snap-mandatory scroll-smooth [&::-webkit-scrollbar]:hidden mb-24">
					{
						books.map(book => {
						const { slug, data } = book
						const { img } = data
						const { book_type } = data
						
						return (
							book_type === "Libro" && (
								<article class="snap-center flex-shrink-0 py-5 px-2.5">
									<a href={`/libro/${slug}`} class="block transition-transform duration-300 hover:scale-110">
										<img 
											transition:name={`img-${slug}`}
											class="mr-5 h-96 rounded"
											src={`/${img}`} 
										/>
									</a>
								</article>
							))
						})
					}
				</div>

				<div class="flex items-center mb-4">
					<h2 class="text-2xl font-bold mr-2">Comics</h2>
					<div class="flex-1 border-b border-gray-500"></div>
				</div>
				<div class="flex overflow-x-auto snap-x snap-mandatory scroll-smooth [&::-webkit-scrollbar]:hidden">
					{
						books.map(book => {
						const { slug, data } = book
						const { img } = data
						const { book_type } = data
						
						return (
							book_type === "Comic" && (
								<article class="snap-center flex-shrink-0 py-5 px-2.5">
									<a href={`/libro/${slug}`} class="block transition-transform duration-300 hover:scale-110">
										<img 
											transition:name={`img-${slug}`}
											class="mr-5 h-96 rounded"
											src={`/${img}`} 
										/>
									</a>
								</article>
							))
						})
					}
				</div>
			</div>
		</section>
    </main>
</Layout>